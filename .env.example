# Local-only credentials. Never use these values outside the developer machine.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres-password
RABBITMQ_DEFAULT_USER=local-rabbitmq
RABBITMQ_DEFAULT_PASS=local-rabbitmq-password
MINIO_ROOT_USER=local-minio
MINIO_ROOT_PASSWORD=local-minio-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-password
GUEST_RSVP_DATABASE_URL=postgresql://guest_rsvp:guest_rsvp_password@localhost:5432/guest_rsvp
NOTIFICATION_DATABASE_URL=postgresql://notification:notification_password@localhost:5432/notification
# console | mailhog | ses | whatsapp | twilio | expo. Tests always use FakeExpoDriver.
NOTIFICATION_CHANNEL=console

# Celebration Site Service (lanes 10-15). Without CELEBRATION_DATABASE_URL it runs in memory.
CELEBRATION_OWNER_PASSWORD=local-celebration-password
CELEBRATION_DATABASE_URL=postgresql://celebration_owner:local-celebration-password@localhost:5432/celebration_db
CELEBRATION_AUTO_MIGRATE=true
CELEBRATION_QUEUE_PREFIX=celebration
RABBITMQ_URL=amqp://local-rabbitmq:local-rabbitmq-password@localhost:5672
IDENTITY_JWKS_URL=http://localhost:8000/identity/.well-known/jwks.json
# Static key set for local stacks without Identity; leave empty to use IDENTITY_JWKS_URL.
IDENTITY_JWKS_JSON=

# Template/Media Service (lane 16). Without TEMPLATE_DATABASE_URL it uses SQLite.
TEMPLATE_OWNER_PASSWORD=local-template-password
TEMPLATE_DATABASE_URL=postgresql://template_owner:local-template-password@localhost:5432/template_db
TEMPLATE_DJANGO_SECRET_KEY=local-only-template-media-secret
TEMPLATE_MEDIA_QUEUE_PREFIX=template-media
MINIO_ENDPOINT=http://localhost:9000
# Host the browser uses for presigned uploads; must be reachable from the client.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=rsvp-media
# Stable public photo URLs (through Kong) used by the public site and Open Graph cards.
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media
# s3 (MinIO/S3) | memory (tests)
MEDIA_STORAGE_BACKEND=s3

