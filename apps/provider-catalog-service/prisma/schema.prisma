generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("PROVIDER_DATABASE_URL") }
model Provider { id String @id; ownerId String; status String; plan String; currency String @default("BOB"); timeZone String }
model ReadProviderMetric { id String @id; day DateTime; category String; destination String; impressions Int @default(0); clicks Int @default(0); validLeads Int @default(0); invalidLeads Int @default(0) }
