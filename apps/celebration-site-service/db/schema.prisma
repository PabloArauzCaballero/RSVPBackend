// Read-only description of celebration_db for tooling (Prisma Studio, introspection).
// The source of truth is db/migrations/*.sql, applied by `yarn migrate`: Row Level Security,
// FORCE RLS and the app_* scope functions cannot be expressed in Prisma, so the service uses
// pg with SQL directly (see docs/progress/DECISIONS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CELEBRATION_DATABASE_URL")
}

model EventTypeDefinition {
  code                     String   @id
  status                   String
  defaultLocale            String   @map("default_locale")
  hostRoles                String[] @map("host_roles")
  enabledSections          String[] @map("enabled_sections")
  requiredFieldsForPublish String[] @map("required_fields_for_publish")
  compatibleTemplateTags   String[] @map("compatible_template_tags")
  updatedAt                DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("event_type_definition")
}

model EventTypeTranslation {
  eventTypeCode  String  @map("event_type_code")
  locale         String
  name           String
  description    String?
  hostRoleLabels Json    @map("host_role_labels")

  @@id([eventTypeCode, locale])
  @@map("event_type_translations")
}

model Celebration {
  id                  String    @id @db.Uuid
  slug                String    @unique(map: "celebration_slug_key")
  ownerId             String    @map("owner_id") @db.Uuid
  organizationId      String?   @map("organization_id") @db.Uuid
  eventTypeCode       String    @map("event_type_code")
  status              String
  version             Int
  defaultLocale       String    @map("default_locale")
  supportedLocales    String[]  @map("supported_locales")
  timeZone            String    @map("time_zone")
  currency            String    @db.Char(3)
  content             Json
  settings            Json
  templateId          String?   @map("template_id") @db.Uuid
  collaborators       Json
  collaboratorUserIds String[]  @map("collaborator_user_ids") @db.Uuid
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(6)

  @@map("celebration")
}

model CelebrationTranslation {
  celebrationId String @map("celebration_id") @db.Uuid
  locale        String
  content       Json

  @@id([celebrationId, locale])
  @@map("celebration_translations")
}

model CelebrationAudit {
  id            String   @id @db.Uuid
  celebrationId String   @map("celebration_id") @db.Uuid
  action        String
  actorId       String?  @map("actor_id") @db.Uuid
  at            DateTime @db.Timestamptz(6)
  eventId       String   @map("event_id") @db.Uuid
  details       Json

  @@map("celebration_audit")
}

model TemplateReference {
  templateId String   @id @map("template_id") @db.Uuid
  tags       String[]
  status     String
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("template_reference")
}

model PublicCelebration {
  slug              String   @id
  celebrationId     String   @unique @map("celebration_id") @db.Uuid
  projectionVersion Int      @map("projection_version")
  lastEventId       String   @map("last_event_id") @db.Uuid
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(6)
  document          Json

  @@map("read_public_celebration")
}
