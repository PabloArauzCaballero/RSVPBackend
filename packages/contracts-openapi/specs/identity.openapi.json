{
  "openapi": "3.1.0", "info": {"title": "RSVP Identity API", "version": "1.0.0"}, "servers": [{"url": "http://localhost:8000/identity"}],
  "paths": {"/health": {"get": {"operationId": "identityHealth", "responses": {"200": {"description": "Healthy"}}}}, "/auth/register": {"post": {"operationId": "registerUser", "responses": {"201": {"description": "Registered"}, "409": {"$ref": "#/components/responses/Conflict"}, "422": {"$ref": "#/components/responses/Validation"}}}}, "/auth/login": {"post": {"operationId": "login", "responses": {"200": {"description": "Session"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}}, "/auth/refresh": {"post": {"operationId": "refreshSession", "responses": {"200": {"description": "Rotated session"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}}, "/auth/password-recovery": {"post": {"operationId": "requestPasswordRecovery", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PasswordRecoveryRequest"}}}}, "responses": {"202": {"description": "Accepted. This response is identical whether or not the account exists."}, "422": {"$ref": "#/components/responses/Validation"}}}}, "/auth/logout": {"post": {"operationId": "logout", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LogoutRequest"}}}}, "responses": {"204": {"description": "Refresh-token chain revoked"}, "422": {"$ref": "#/components/responses/Validation"}}}}, "/.well-known/jwks.json": {"get": {"operationId": "jwks", "responses": {"200": {"description": "JWKS"}}}}},
  "components": {"schemas": {"Problem": {"type": "object", "required": ["type", "title", "status"], "properties": {"type": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "integer"}, "correlationId": {"type": "string", "format": "uuid"}}}, "PasswordRecoveryRequest": {"type": "object", "additionalProperties": false, "required": ["email"], "properties": {"email": {"type": "string", "format": "email", "maxLength": 320}}}, "LogoutRequest": {"type": "object", "additionalProperties": false, "required": ["refreshToken"], "properties": {"refreshToken": {"type": "string", "minLength": 32, "maxLength": 4096}}}}, "responses": {"Unauthorized": {"description": "Authentication failed"}, "Conflict": {"description": "Resource conflict"}, "Validation": {"description": "Validation failed"}}}
}
