{
  "openapi":"3.1.0",
  "info":{"title":"RSVP Provider Catalog API","version":"1.0.0"},
  "servers":[{"url":"http://localhost:8000/providers"}],
  "paths":{
    "/health":{"get":{"responses":{"200":{"description":"Healthy"}}}},
    "/":{"get":{"operationId":"searchProviders","parameters":[{"name":"coverage","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Verified published listings only"}}},"post":{"operationId":"registerProvider","responses":{"201":{"description":"Provider created"},"422":{"$ref":"#/components/responses/Validation"}}}},
    "/{providerId}/verify":{"post":{"operationId":"verifyProvider","responses":{"200":{"description":"Provider verified"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/{providerId}/listings":{"post":{"operationId":"createListing","responses":{"201":{"description":"Listing created"},"422":{"$ref":"#/components/responses/Validation"}}}},
    "/r/{listingId}":{"get":{"operationId":"resolveListingRedirect","parameters":[{"name":"listingId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"destination","in":"query","required":true,"schema":{"type":"string","enum":["OFFICIAL_SITE","LANDING","WHATSAPP","PHONE","EMAIL","INSTAGRAM","PRODUCT_PAGE"]}}],"responses":{"302":{"description":"Temporary redirect. A permanent 301 is forbidden because it bypasses future lead tracking."},"404":{"$ref":"#/components/responses/NotFound"}}}},
    "/{providerId}/calendar":{"get":{"operationId":"getProviderCalendar","responses":{"200":{"description":"Monthly availability in provider time zone"}}}},
    "/{providerId}/bookings":{"post":{"operationId":"requestBooking","responses":{"201":{"description":"Booking requested"},"409":{"description":"No capacity remains"},"422":{"description":"Date is outside availability or blocked"}}}},
    "/{providerId}/quotes":{"post":{"operationId":"requestQuote","responses":{"201":{"description":"Quote requested"},"422":{"$ref":"#/components/responses/Validation"}}}}
  },
  "components":{"schemas":{"Problem":{"type":"object","required":["type","title","status"],"properties":{"type":{"type":"string"},"title":{"type":"string"},"status":{"type":"integer"}}}},"responses":{"NotFound":{"description":"Verified listing or enabled destination not found"},"Validation":{"description":"Invalid request or missing fulfillment"},"Forbidden":{"description":"Provider owner or administrator role required"},"Conflict":{"description":"Invalid state transition or exhausted capacity"}}}
}
